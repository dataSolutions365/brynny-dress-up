// Security rules for the brynny-dress-up Firebase project (cloud save + 💌 Notes in the 2D studio).
// The game itself can't set these: paste this into Firebase console > Firestore Database > Rules > Publish.
//
// Each signed-in account gets its own space, families/{uid}. Only that same account can read or write it,
// so 💌 Notes only travel between phones signed in to the same family account. Nobody else can send one.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // everything else is closed
  }
}
